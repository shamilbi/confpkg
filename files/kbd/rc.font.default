# By default, $FONT is auto. This tries various sizes of Terminus fonts to
# find the largest one that meets the minimum columns requirement.
# This can also be set to "none" (leave the console alone), or to a
# specific font in /usr/share/kbd/consolefonts such as "ter-v28b".
FONT=auto

# If you are loading a specific font and want the size doubled, uncomment
# the following line:
#FONTDOUBLE=" -d "

# Apply new new font on all the consoles, not just the one you're using.
APPLY_NEW_FONT_ON_ALL_CONSOLES=true

# The following settings are used when FONT=auto:

# A list of fonts to try, smallest to largest:
TRYFONTS="ter-v14b ter-v16b ter-v20b ter-v22b ter-v24b ter-v28b ter-v32b"

# We want to find the largest font that provides our minimum columns.
MINCOLS=130

