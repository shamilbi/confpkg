#!/bin/bash

UseBuildDir=1

ConfigureOpts=(
    --prefix="$Prefix"
    --libdir="$LibDir"
    --mandir="$ManDir"
    --infodir="$InfoDir"
    --sysconfdir="$Etc"
    --buildtype=release
    --backend=ninja
)

pkg_del_cflags '-std=gnu17'

pkg_configure() {
    local d=$SrcDir/_tmp
    mkdir -pm 700 "$d"
    export TMPDIR=$d
    meson setup "${ConfigureOpts[@]}" "$BuildDir" "$SrcDir" || return 1
}

pkg_make() {
    ninja -C "$BuildDir"
}

pkg_install() {
    env "${InstallEnv[@]}" ninja -C "$BuildDir" install
}
