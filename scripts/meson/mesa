#!/bin/bash

PkgHome="https://gitlab.freedesktop.org/mesa/mesa/-/tags"

ConfigureOpts+=(
    # Slackware
    -Dplatforms=x11,wayland
    -Dgallium-rusticl=true
    -Dgallium-extra-hud=true
    -Drust_std=2021
    # # Be sure this list is up-to-date:
    # GALLIUM_DRIVERS="nouveau,r300,r600,svga,radeonsi,softpipe,llvmpipe,virgl,i915,iris,crocus,zink,d3d12"
    #-Dgallium-drivers=$GALLIUM_DRIVERS
    -Dvulkan-drivers=amd,intel,intel_hasvk,swrast,virtio,nouveau
    -Dvulkan-layers=device-select,intel-nullhw,overlay
    # CODECS=${CODECS:-h264dec,h264enc,h265dec,h265enc,vc1dec,av1dec,av1enc,vp9dec}
    #-Dvideo-codecs="$CODECS"
    -Dvideo-codecs=h264dec,h264enc,h265dec,h265enc,vc1dec,av1dec,av1enc,vp9dec
    -Dglvnd=enabled
    -Dllvm=enabled
    -Dshared-llvm=enabled
    -Degl=enabled
    -Dgles1=enabled
    -Dgles2=enabled
    -Dopengl=true
    -Dglx=dri
    -Dlibunwind=disabled
    -Dmicrosoft-clc=disabled
    -Dvalgrind=enabled

    -Dgallium-drivers=auto
        # value : ['auto'],
        # choices : [
        #     'all', 'auto', 'asahi', 'crocus', 'd3d12', 'etnaviv', 'freedreno',
        #     'i915', 'iris', 'lima', 'llvmpipe', 'nouveau', 'panfrost', 'r300',
        #     'r600', 'radeonsi', 'softpipe', 'svga', 'tegra', 'v3d', 'vc4',
        #     'virgl', 'zink', ],
        # List of gallium drivers to build. If this is set to auto
        # all drivers applicable to the target OS/architecture
        # will be built.
)

# Slackware
# Only supported on x86_64:
[[ $Arch = "x86_64" ]] && ConfigureOpts+=(-Dintel-rt=enabled)

unset ProtectDirs
#   etc/OpenCL/vendors/mesa.icd
ProtectFiles=(
    # Slackware
    # Install /etc/drirc as a .new file:
    /etc/drirc
)

pkg_pre_configure() {
    local f

    # Slackware
    # Let's kill the warning about operating on a dangling symlink:
    f="src/gallium/state_trackers/d3d1x/w32api"
    [[ -f $f ]] && rm -f "$f"
    :
}

pkg_post_install() {
    local dir

    # Slackware
    # Add a default provider for glvnd when the vendor cannot be determined:
    (
        cd "$LibDir2" || exit 1
        if [[ ! -r libGLX_system.so.0 ]]; then
            echo "link libGLX_mesa.so.0 --> libGLX_system.so.0"
            ln -sfnr libGLX_mesa.so.0 libGLX_system.so.0
        fi
    ) || return 1
}
