#!/bin/bash

PkgHome="https://github.com/gwsw/less/tags"

ConfigureOpts+=(
    --with-editor=vim # use PROGRAM as the default editor [vi]
)

pkg_pre_configure() {
    local file

    # Slackware
    # Fix path in manpage:
    file=less.nro
    if [[ -r $file ]]; then
        sed -i "s,/usr/local/etc,/etc,g" "$file"
    fi
    # Prep needed if using the git archive:
    for file in funcs.h less.nro lesskey.nro lessecho.nro lessmsg.inc; do
        if [[ ! -r $file ]]; then
            make -f Makefile.aut "$file"
        fi
    done
}

pkg_post_install() {
    local i

    # Slackware
    # Install profile scripts:
    for i in less.sh less.csh; do
        pkg_install_mfd 755 "$SupportDir/$i" "$Etc2"/profile.d
    done
}
