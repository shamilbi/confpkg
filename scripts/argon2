#!/bin/bash

PkgHome=(
    "https://github.com/P-H-C/phc-winner-argon2/tags"
    "$SlackwareMirrorUrl/l/argon2/?C=M&O=D"
)

InstallEnv=(
	INST_INCLUDE="$IncludeDir2"
	INST_LIBRARY="$LibDir2"
	INST_BINARY="$Prefix2"/bin
	INST_PKGCONFIG="$LibDir2"/pkgconfig
)
CheckOpts=(test)
CleanOpts=(clean)

pkg_pre_configure() {
    # Slackware
    # Fix build options and library path:
    local f=Makefile
    sed -i "s/CFLAGS += -std=c89 -O3 -Wall -g -Iinclude -Isrc/CFLAGS += -std=c89 -Iinclude -Isrc/g" "$f"
    sed -i 's/LIBRARY_REL ?= lib.*/LIBRARY_REL = '"$LibName"'/g' "$f"
    sed -i 's/CFLAGS += -march=\$(OPTTARGET)/CFLAGS += '"$CFLAGS"'/g' "$f"
}

pkg_post_install() {
    # Slackware
    # Ditch static library:
    find "$LibDir2" -type f -name '*.a' -delete
    # Fix library perms:
    chmod 755 "$LibDir2"/libargon2*
    # Install man page:
    pkg_install_mfd 644 man/argon2.1 "$ManDir2"/man1
}
