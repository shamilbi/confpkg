#!/bin/bash

PkgHome=(
    "https://invisible-island.net/archives/dialog/?C=M;O=D"
    "$SlackwareMirrorUrl/a/dialog/?C=M&O=D"
)

pkg_configure_del --docdir --localedir
unset -v pkg_check

ConfigureOpts+=(
    # Slackware
    --enable-nls
    --with-ncursesw
    --enable-widec
)

pkg_pre_configure() {
    # Slackware
    # This patch take care of a formatting issue that was preventing
    # us from moving to a more recent version of dialog:
    pkg_patch_f3 dialog.no.aspect.ratio.autoadjust.patch 1 || return 1
    # Fix upstreamable bug:
    pkg_patch_f3 dialog.autosize.listheight.diff 1 || return 1
}

pkg_post_install() {
    # Slackware
    # Keep the old traditional looknfeel :-)
    # /etc/dialogrc
    pkg_install_mff 644 samples/slackware.rc "$Etc2"/dialogrc
    # Don't package this static library:
    find "$LibDir2" -type f -name 'libdialog.a' -delete
    find "$LibDir2" -depth -type d -empty -delete
    # /bin/dialog
    echo "$Prefix2"/bin/dialog | pkg_mv_ln "$DestDir"/bin
}
