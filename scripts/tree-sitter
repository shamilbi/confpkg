#!/bin/bash

PkgHome="https://github.com/tree-sitter/tree-sitter/tags"

MakeEnv=(
    # Slackware
    PREFIX="$Prefix"
    LIBDIR="$LibDir"
)
InstallEnv+=("${MakeEnv[@]}")

pkg_make() {
    # Slackware
    "${Make[@]}" "${MakeEnv[@]}" "${MakeOpts[@]}" || return 1
    # Build and install cli:
    (
        cd crates/cli || exit 1
        cargo build --release --locked --all-features
    ) || return 1
}

pkg_post_install() {
    # Slackware
    pkg_install_mfd 755 target/release/tree-sitter "$Prefix2"/bin
    # No static library:
    find "$LibDir2" -type f -name '*.a' -delete
}
